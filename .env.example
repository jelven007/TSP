# ===== TickFlow (optional alternative) =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== Built-in extended datasets =====
# Empty values use the built-in concept/industry endpoints; custom URLs override them.
# New installations pull manually; enable automatic pulling explicitly in pull settings.
EXT_CONCEPT_DATA_URL=
EXT_INDUSTRY_DATA_URL=

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | openai | codex_cli
AI_PROTOCOL=chat_completions       # chat_completions | responses
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MAX_OUTPUT_TOKENS=16384
AI_CONTEXT_WINDOW=128000
AI_ROUND_CHECKPOINT=100            # 助手连续工具轮次检查点；0 不检查；不是每日费用上限

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 非 Windows 默认开启完整多租户, SERVICE_ROLE 默认 api; Windows 默认单机管理员。
# 首次部署准备 PostgreSQL control/business 库、schema v6 和各自的运行角色,
# 并启动平台服务和 Worker; 初始化步骤见 deploy/full/README.md。
# 显式 MULTITENANCY_ENABLED=false 可保留旧独立模式, 不影响 Windows 规则。
# 原生 Windows 默认单机管理员 admin/Admin123, 拥有个人空间并暂停多租户。
# Windows 下请使用 SERVICE_ROLE=standalone; 下方邮箱初始化不覆盖本地管理员。
# 原生 Windows 强制 LOCAL_ADMIN_MODE=true, 一般无需填写。改密后重启不会重置。
# 所有环境: 全新安装以下三项留空时, 自动预置管理员 admin/Admin123。
# 管理员预置不切换运行模式; Windows 另行默认启用单机管理员模式。
# 可选: AUTH_USERNAME 与 AUTH_PASSWORD 同时填写, 指定预置管理员。
AUTH_USERNAME=''
# 可选: 首次启动时预置邮箱账户。两项同时填写才会直接创建邮箱账户。
# AUTH_USERNAME 非空时优先预置管理员; 已有邮箱账户保留。
# 仅填 AUTH_PASSWORD 会进入旧版兼容模式, 首次访问时需绑定邮箱。
# 密码至少 8 位。仅在尚无账户时生效, 后续改密码请使用设置页。
AUTH_EMAIL=''
AUTH_PASSWORD=''

# 注册与找回密码默认开启, 首次自动初始化注册口令“天王盖地虎”。
# 可用此字段自定义; 首次生成哈希后不覆盖已修改口令。
AUTH_REGISTRATION_SECRET=''

# 注册及通知共用 SMTP; 凭据由部署环境或受控配置提供，不随源码发布。
# AUTH_SMTP_HOST 留空: 优先已保存系统 SMTP，再使用完整多租户 TSP_CELL_SMTP_*。
# 均未配置时邮件不可用，注册和找回密码不能完成邮件验证。
# SECURITY: ssl | starttls | none
# AUTH_SMTP_PASSWORD 填客户端授权码, 不要填邮箱登录密码。
AUTH_SMTP_HOST=''
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURITY=ssl
AUTH_SMTP_USERNAME=''
AUTH_SMTP_PASSWORD=''
AUTH_SMTP_FROM_ADDRESS=''

# 非 Windows 完整多租户数据库与内部服务配置, 填入已准备的运行连接信息。
# 以下保持注释以便 Windows 直接使用同一模板; 详细完整环境见 deploy/full/README.md。
# TSP_CELL_ID=full
# TSP_CELL_SCHEMA_VERSION=6
# TSP_CELL_CONTROL_DSN='postgresql://identity_runtime:password@127.0.0.1/tsp_control'
# TSP_CELL_DATA_DSN='postgresql://business_runtime:password@127.0.0.1/tsp_business'
# TSP_CELL_MARKET_URL='http://127.0.0.1:3029'
# TSP_CELL_MARKET_TOKEN='内部行情令牌'
# TSP_CELL_STREAM_TICKET_SECRET='内部流票据密钥'
# TSP_PLATFORM_ADMIN_TOKEN='内部平台管理令牌'
# PLATFORM_CONFIG_DIR='./platform-config'
# TENANT_ARTIFACTS_DIR='./tenant-artifacts'

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest
BACKEND_EXTRAS=

# ===== Data =====
DATA_DIR=./data

# rustdx v2.0.4 / bridge API4: realtime, minute and history each share 8+1.
# Set 0 to retain the legacy single 8-business/1-probe pool.
RUSTDX_TASK_GROUPS=1
RUSTDX_QUOTE_CONNECTIONS=8
RUSTDX_WORKERS=8
# Explicit background cap, also retained after close and for history tasks.
# Omit for group-mode defaults: intraday minute 6, after close/history 8.
RUSTDX_BACKGROUND_CONNECTIONS=7
RUSTDX_MAX_PAGES=64
RUSTDX_SERVER=117.34.114.13:7709
RUSTDX_FINANCIAL_SERVER=120.76.152.87:7709
RUSTDX_TIMEOUT=8
# Optional ranked seed pool and explicit task main/backup lists:
# RUSTDX_NODE_SERVERS=ip1:7709,ip2:7709,ip3:7709
# RUSTDX_REALTIME_SERVER=ip1:7709
# RUSTDX_MINUTE_SERVER=ip2:7709
# RUSTDX_HISTORY_SERVER=ip3:7709
# RUSTDX_REALTIME_FALLBACK_SERVERS=ip4:7709,ip7:7709
# RUSTDX_MINUTE_FALLBACK_SERVERS=ip5:7709,ip8:7709
# RUSTDX_HISTORY_FALLBACK_SERVERS=ip6:7709,ip9:7709
# RUSTDX_NETWORK_SHARED_DIR=/controlled/path/rustdx-permits

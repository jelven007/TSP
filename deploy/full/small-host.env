# Isolated functional acceptance on an 8 GiB Docker host, using a small fixture.
# Seven services: 3584 MiB. Also budget PostgreSQL 384 MiB, broker 128 MiB,
# edge 64 MiB and ONE compute container 1024 MiB: 5184 MiB total.
# This is not a production market-history or 100-user capacity recommendation.
TSP_FULL_API_WORKERS=1
TSP_FULL_POOL_SIZE=2
TSP_GATEWAY_POOL_SIZE=2
TSP_REALTIME_POOL_SIZE=2
TSP_PLATFORM_THREADS=2
TSP_PLATFORM_MEMORY=1024m
TSP_PLATFORM_CPUS=2
TSP_API_MEMORY=1024m
TSP_API_CPUS=2
TSP_GATEWAY_MEMORY=256m
TSP_GATEWAY_CPUS=1
TSP_RESEARCH_MEMORY=256m
TSP_RESEARCH_CPUS=1
TSP_RESEARCH_CONCURRENCY=1
TSP_REALTIME_MEMORY=384m
TSP_REALTIME_CPUS=1
TSP_REALTIME_CONCURRENCY=1
TSP_NOTIFICATIONS_MEMORY=256m
TSP_NOTIFICATIONS_CPUS=0.5
TSP_NOTIFICATIONS_CONCURRENCY=1
TSP_SCHEDULED_MEMORY=384m
TSP_SCHEDULED_CPUS=1
TSP_SCHEDULED_CONCURRENCY=1
TSP_COMPUTE_CAPACITY=1
TSP_COMPUTE_MEMORY_MB=1024
TSP_COMPUTE_CPUS=1

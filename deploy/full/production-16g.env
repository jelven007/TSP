# Production budget for one 16 GiB host. Apply with deploy/full/compose.yml.
# Seven application roles reserve 8704 MiB. Keep another 2048 MiB for one
# Compute, 1536 MiB for PostgreSQL, 384 MiB for broker/edge, and 3072 MiB for
# the kernel, Docker and filesystem cache. Total planned use: 15744 MiB.
TSP_FULL_API_WORKERS=2
TSP_FULL_POOL_SIZE=4
TSP_GATEWAY_POOL_SIZE=2
TSP_RESEARCH_POOL_SIZE=2
TSP_REALTIME_POOL_SIZE=2
TSP_NOTIFICATIONS_POOL_SIZE=2
TSP_SCHEDULED_POOL_SIZE=2

# Two database pools exist per process. This profile therefore caps the seven
# roles at 36 PostgreSQL connections; configure PostgreSQL max_connections >=64.
TSP_PLATFORM_THREADS=4
TSP_PLATFORM_MEMORY=4096m
TSP_PLATFORM_CPUS=3
TSP_API_MEMORY=2048m
TSP_API_CPUS=2
TSP_GATEWAY_MEMORY=512m
TSP_GATEWAY_CPUS=0.5
TSP_RESEARCH_MEMORY=512m
TSP_RESEARCH_CPUS=0.75
TSP_RESEARCH_CONCURRENCY=1
TSP_REALTIME_MEMORY=768m
TSP_REALTIME_CPUS=1
TSP_REALTIME_CONCURRENCY=1
TSP_NOTIFICATIONS_MEMORY=256m
TSP_NOTIFICATIONS_CPUS=0.25
TSP_NOTIFICATIONS_CONCURRENCY=1
TSP_SCHEDULED_MEMORY=512m
TSP_SCHEDULED_CPUS=0.5
TSP_SCHEDULED_CONCURRENCY=1

TSP_COMPUTE_CAPACITY=1
TSP_COMPUTE_MEMORY_MB=2048
TSP_COMPUTE_CPUS=1
TSP_COMPUTE_QUEUE_SECONDS=2

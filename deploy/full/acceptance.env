# Experimental real-market + 100-active-user budget for this 8 GiB Docker host.
# Services 5376 MiB including one 1024 MiB compute; load/observers 640 MiB.
# This budget is under acceptance, not a certified production sizing.
TSP_FULL_API_WORKERS=1
TSP_FULL_POOL_SIZE=4
TSP_GATEWAY_POOL_SIZE=4
TSP_REALTIME_POOL_SIZE=2
TSP_PLATFORM_THREADS=2
TSP_PLATFORM_MEMORY=1536m
TSP_PLATFORM_CPUS=2
TSP_API_MEMORY=768m
TSP_API_CPUS=2
TSP_GATEWAY_MEMORY=384m
TSP_GATEWAY_CPUS=1
TSP_RESEARCH_MEMORY=256m
TSP_RESEARCH_CPUS=1
TSP_RESEARCH_CONCURRENCY=1
TSP_REALTIME_MEMORY=384m
TSP_REALTIME_CPUS=1
TSP_REALTIME_CONCURRENCY=1
TSP_NOTIFICATIONS_MEMORY=192m
TSP_NOTIFICATIONS_CPUS=0.5
TSP_NOTIFICATIONS_CONCURRENCY=1
TSP_SCHEDULED_MEMORY=256m
TSP_SCHEDULED_CPUS=1
TSP_SCHEDULED_CONCURRENCY=1
TSP_COMPUTE_CAPACITY=1
TSP_COMPUTE_MEMORY_MB=1024
TSP_COMPUTE_CPUS=1

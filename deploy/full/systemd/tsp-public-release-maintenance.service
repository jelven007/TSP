[Unit]
Description=Retain immutable public market releases
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/tsp-full/public-release-maintenance.env
ExecStart=/usr/bin/python3 /opt/tsp-full/maintenance/maintain_full_host.py --release-root ${TSP_PUBLIC_MARKET_DIR} --postgres-container ${TSP_POSTGRES_CONTAINER} --business-database ${TSP_BUSINESS_DATABASE} --keep-releases 30 --min-release-age-hours 6 --apply
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
